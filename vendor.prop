# ALS
vendor.sensors.als_correction.grabrect=666 0 794 104

# Bluetooth
bluetooth.device.default_name=OnePlus Nord CE3 5G

# Graphics
ro.surface_flinger.set_idle_timer_ms=1100
ro.surface_flinger.set_touch_timer_ms=200
ro.surface_flinger.uclamp.min=150

# Radio
persist.radio.multisim.config=dsds

# USB
vendor.usb.product_string=OnePlus Nord CE3 5G

#Display
debug.graphics.game_default_frame_rate.disabled=true
